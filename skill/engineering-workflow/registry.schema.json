{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/AhmedAbdelhady24/engineering-workflow/master/skill/engineering-workflow/registry.schema.json",
  "title": "SpecialistSkillRegistry",
  "description": "JSON Schema draft 2020-12 specification for Universal Engineering Workflow specialist skill registry and routing matrix",
  "type": "object",
  "required": ["$schema", "version", "description", "skills"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+"
    },
    "description": {
      "type": "string",
      "minLength": 10
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "canonicalName",
          "capabilityType",
          "upstream",
          "source",
          "category",
          "purpose",
          "triggerConditions",
          "invocationPolicy",
          "dependencies",
          "conflicts",
          "installation",
          "hosts",
          "fallbackType",
          "fallbackPolicy",
          "executionEvidence"
        ],
        "additionalProperties": false,
        "properties": {
          "canonicalName": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]+$"
          },
          "capabilityType": {
            "type": "string",
            "enum": ["external-skill", "mcp-tool", "bundled-operation"]
          },
          "upstream": {
            "type": "string",
            "format": "uri"
          },
          "source": {
            "type": "object",
            "required": ["repository", "verifiedAt"],
            "additionalProperties": false,
            "properties": {
              "repository": {
                "type": "string",
                "format": "uri"
              },
              "revision": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              "package": {
                "type": "string"
              },
              "version": {
                "type": "string"
              },
              "verifiedAt": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              }
            }
          },
          "category": {
            "type": "string"
          },
          "purpose": {
            "type": "string",
            "minLength": 15
          },
          "triggerConditions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "invocationPolicy": {
            "type": "string",
            "enum": ["model-invocable", "user-only", "host-dependent"]
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "conflicts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "installation": {
            "type": "object",
            "required": ["strategy", "command"],
            "additionalProperties": false,
            "properties": {
              "strategy": {
                "type": "string",
                "enum": ["skills-cli", "mcp-server", "claude-plugin", "bundled"]
              },
              "command": {
                "type": "string",
                "minLength": 5
              },
              "hosts": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            }
          },
          "hosts": {
            "type": "object",
            "required": ["compatible", "installable", "verifiedExecuted"],
            "additionalProperties": false,
            "properties": {
              "compatible": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "installable": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "verifiedExecuted": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "fallbackType": {
            "type": "string",
            "enum": ["principles-based", "not-applicable", "static-analysis"]
          },
          "fallbackPolicy": {
            "type": "string",
            "minLength": 10
          },
          "executionEvidence": {
            "type": "string",
            "minLength": 10
          }
        }
      }
    }
  }
}
